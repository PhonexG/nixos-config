# Rail Dark — Fish Shell Syntax & Pager Colors

# Syntax highlighting
set -g fish_color_normal cfd6e2
set -g fish_color_command 88a4d4
set -g fish_color_keyword 88c0d0
set -g fish_color_quote a3be8c
set -g fish_color_redirection ebcb8b
set -g fish_color_end 88c0d0
set -g fish_color_error bf616a
set -g fish_color_param cfd6e2
set -g fish_color_valid_path a3be8c --underline
set -g fish_color_option 88c0d0
set -g fish_color_comment 8b95a7
set -g fish_color_selection --background=2e3440
set -g fish_color_operator 88c0d0
set -g fish_color_escape ebcb8b
set -g fish_color_autosuggestion 8b95a7
set -g fish_color_cwd 88a4d4
set -g fish_color_cwd_root bf616a
set -g fish_color_user a3be8c
set -g fish_color_host 88c0d0
set -g fish_color_host_remote ebcb8b
set -g fish_color_status bf616a
set -g fish_color_search_match --background=2e3440
set -g fish_color_history_current --bold

# Completion pager
set -g fish_pager_color_progress 8b95a7 --background=252a34
set -g fish_pager_color_background --background=1e222a
set -g fish_pager_color_prefix 88c0d0 --bold --underline
set -g fish_pager_color_completion cfd6e2
set -g fish_pager_color_description ebcb8b
set -g fish_pager_color_selected_background --background=2e3440
set -g fish_pager_color_selected_prefix 88a4d4 --bold
set -g fish_pager_color_selected_completion cfd6e2
set -g fish_pager_color_selected_description ebcb8b
set -g fish_pager_color_secondary_background --background=252a34
set -g fish_pager_color_secondary_prefix 88c0d0
set -g fish_pager_color_secondary_completion cfd6e2
set -g fish_pager_color_secondary_description 8b95a7
