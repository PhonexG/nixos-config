{
  "$schema": "https://f.jstanger.dev/github/ironbar/schema.json",
  "name": "main",
  "position": "top",
  "anchor_to_edges": false,
  "layer": "overlay",
  "exclusive_zone": false,
  "popup_gap": 38,
  "height": 1,
  "margin": {
    "top": 0,
    "bottom": 0,
    "left": 0,
    "right": 0
  },
  "center": [
    {
      "type": "custom",
      "name": "dropdown",
      "class": "dropdown-tab",
      "on_mouse_enter": "ironbar style add-class dropdown open",
      "on_mouse_exit": "ironbar style remove-class dropdown open",
      "bar": [
        {
          "type": "box",
          "name": "dropdown-box",
          "class": "dropdown-box",
          "widgets": [
            {
              "type": "sys_info",
              "name": "cpu",
              "class": "bar-pill item-cpu",
              "format": ["  {cpu_percent}%"],
              "interval": {
                "cpu": 1
              },
              "on_mouse_enter": "ironbar style add-class dropdown open",
              "on_click_left": "kitty -e btop"
            },
            {
              "type": "custom",
              "name": "wifi",
              "class": "bar-pill item-wifi",
              "on_mouse_enter": "ironbar style add-class dropdown open",
              "bar": [
                {
                  "type": "button",
                  "name": "wifi-btn",
                  "class": "wifi-btn",
                  "label": "{{watch:/home/oni/.config/ironbar/wifi-status.sh}}",
                  "on_click": "!kitty -e nmtui"
                }
              ]
            },
            {
              "type": "custom",
              "name": "speaker",
              "class": "bar-pill item-speaker",
              "on_mouse_enter": "ironbar style add-class dropdown open",
              "bar": [
                {
                  "type": "button",
                  "name": "speaker-btn",
                  "class": "speaker-btn",
                  "label": "{{watch:/home/oni/.config/ironbar/speaker-status.sh}}",
                  "on_click": "!pavucontrol"
                }
              ]
            },
            {
              "type": "clock",
              "name": "clock",
              "class": "bar-pill item-clock",
              "format": "  %H:%M",
              "format_popup": "%A, %d %B %Y",
              "on_mouse_enter": "ironbar style add-class dropdown open"
            },
            {
              "type": "custom",
              "name": "mic",
              "class": "bar-pill item-mic",
              "on_mouse_enter": "ironbar style add-class dropdown open",
              "bar": [
                {
                  "type": "button",
                  "name": "mic-btn",
                  "class": "mic-btn",
                  "label": "{{watch:/home/oni/.config/ironbar/mic-status.sh}}",
                  "on_click": "!wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
                }
              ]
            },
            {
              "type": "bluetooth",
              "name": "bluetooth",
              "class": "bar-pill item-bt",
              "icon_size": 15,
              "disable_popup": true,
              "on_mouse_enter": "ironbar style add-class dropdown open",
              "on_click_left": "blueman-manager",
              "format": {
                "disabled": "󰂲  Off",
                "enabled": "󰂯  On",
                "connected": "󰂱  {device_alias}",
                "connected_battery": "󰂱  {device_alias} {device_battery_percent}%"
              }
            },
            {
              "type": "custom",
              "name": "battery",
              "class": "bar-pill item-battery",
              "on_mouse_enter": "ironbar style add-class dropdown open",
              "bar": [
                {
                  "type": "label",
                  "name": "battery-lbl",
                  "class": "battery-lbl",
                  "label": "{{watch:/home/oni/.config/ironbar/battery-status.sh}}"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
