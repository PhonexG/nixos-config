{
  "name": "main",
  "position": "top",
  "height": 34,
  "start_hidden": true,
  "margin": {
    "top": 6,
    "bottom": 0,
    "left": 12,
    "right": 12
  },
  "start": [
    {
      "type": "custom",
      "class": "logo-box",
      "bar": [
        {
          "type": "button",
          "name": "logo-btn",
          "class": "logo-btn",
          "label": "",
          "on_click": "!$HOME/.config/niri/scripts/menu-control.sh launcher"
        }
      ]
    },
    {
      "type": "workspaces",
      "all_monitors": false,
      "sort": "alphanumeric"
    },
    {
      "type": "focused",
      "show_icon": false,
      "show_title": true,
      "truncate": {
        "mode": "end",
        "max_length": 42
      }
    }
  ],
  "center": [
    {
      "type": "clock",
      "format": "󰃰  %H:%M",
      "format_popup": "%A, %d %B %Y"
    }
  ],
  "end": [
    {
      "type": "tray",
      "icon_size": 16
    },
    {
      "type": "notifications",
      "show_count": true
    },
    {
      "type": "custom",
      "class": "clip-box",
      "bar": [
        {
          "type": "button",
          "name": "clip-btn",
          "class": "clip-btn",
          "label": "",
          "on_click": "!$HOME/.config/niri/scripts/clipboard-picker.sh"
        }
      ]
    },
    {
      "type": "network_manager",
      "icon_size": 16
    },
    {
      "type": "volume",
      "format": "{icon} {percentage}%",
      "icons": {
        "volume_high": "󰕾",
        "volume_medium": "󰖀",
        "volume_low": "󰕿",
        "muted": "󰝟"
      }
    },
    {
      "type": "upower",
      "format": "{percentage}%",
      "icon_size": 16
    },
    {
      "type": "custom",
      "class": "power-box",
      "bar": [
        {
          "type": "button",
          "name": "power-btn",
          "class": "power-btn",
          "label": "⏻",
          "on_click": "!$HOME/.config/niri/scripts/menu-control.sh power"
        }
      ]
    }
  ]
}
