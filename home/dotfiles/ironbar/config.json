{
  "$schema": "https://f.jstanger.dev/github/ironbar/schema.json",
  "name": "main",
  "position": "top",
  "anchor_to_edges": false,
  "layer": "overlay",
  "exclusive_zone": false,
  "popup_gap": 30,
  "height": 26,
  "autohide": 350,
  "start_hidden": true,
  "ironvar_defaults": {
    "tray_open": "false",
    "tray_arrow": "",
    "notifications_status": "Notifications: loading status…"
  },
  "margin": {
    "top": 0,
    "bottom": 0,
    "left": 0,
    "right": 0
  },
  "start": [],
  "center": [
    {
      "type": "custom",
      "name": "tray-expander",
      "class": "item-tray-toggle",
      "tooltip": "Tray — click to open / close",
      "bar": [
        {
          "type": "button",
          "name": "tray-toggle-btn",
          "label": "#tray_arrow",
          "on_click": "!/home/oni/.config/ironbar/controls.sh tray-toggle"
        },
        {
          "type": "tray",
          "name": "tray",
          "icon_size": 16,
          "show_if": "#tray_open",
          "transition_type": "none",
          "exclude": ["nm-applet", "blueman"]
        }
      ]
    },
    {
      "type": "custom",
      "name": "notifications",
      "class": "bar-icon item-notifications",
      "tooltip": "#notifications_status\nLeft click: notifications · Right click: Do Not Disturb",
      "bar": [
        {
          "type": "button",
          "name": "notifications-btn",
          "label": "{{watch:python3 /home/oni/.config/ironbar/notifications.py}}",
          "on_click": "!/home/oni/.config/ironbar/controls.sh notifications",
          "on_click_right": "/home/oni/.config/ironbar/controls.sh dnd"
        }
      ]
    },
    {
      "type": "bluetooth",
      "name": "bluetooth",
      "class": "item-bt",
      "icon_size": 16,
      "tooltip": "Bluetooth — devices and connections",
      "popup": {
        "header": "  Bluetooth",
        "scrollable": true,
        "device": {
          "header": "{device_alias}",
          "header_battery": "{device_alias}",
          "footer": "{device_status}",
          "footer_battery": "{device_status} · {device_battery_percent}%"
        }
      },
      "adapter_status": {
        "not_found": "No Bluetooth adapter found",
        "enabled": "Bluetooth enabled",
        "enabling": "Enabling…",
        "disabled": "Bluetooth disabled",
        "disabling": "Disabling…"
      },
      "device_status": {
        "connected": "Connected",
        "connecting": "Connecting…",
        "disconnected": "Disconnected",
        "disconnecting": "Disconnecting…"
      },
      "format": {
        "disabled": "󰂲",
        "enabled": "",
        "connected": "󰂱",
        "connected_battery": "󰂱"
      }
    },
    {
      "type": "network_manager",
      "name": "wifi",
      "class": "item-wifi"
    },
    {
      "type": "volume",
      "name": "speaker",
      "class": "bar-icon item-speaker",
      "format": "{icon}",
      "max_volume": 100,
      "icons": {
        "volume_high": "",
        "volume_medium": "",
        "volume_low": "",
        "muted": ""
      },
      "truncate": { "mode": "end", "max_length": 24 },
      "tooltip": "{{2000:/home/oni/.config/ironbar/speaker-status.sh --summary}}\nLeft click: mixer · Right click: mute · Wheel: ±5%",
      "on_click_right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on_scroll_up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
      "on_scroll_down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
      "smooth_scroll_speed": 10
    },
    {
      "type": "custom",
      "name": "cpu",
      "class": "bar-icon item-cpu",
      "tooltip": "CPU usage",
      "bar": [
        { "type": "button", "name": "cpu-btn", "label": "󰍛", "on_click": "popup:toggle" }
      ],
      "popup": [
        {
          "type": "box",
          "orientation": "vertical",
          "widgets": [
            { "type": "label", "class": "popup-title", "label": "Processor" },
            { "type": "label", "class": "stats", "justify": "left", "label": "{{watch:python3 /home/oni/.config/ironbar/panel-status.py cpu}}" }
          ]
        }
      ]
    },
    {
      "type": "custom",
      "name": "battery",
      "class": "bar-icon item-battery",
      "tooltip": "{{30000:/home/oni/.config/ironbar/battery-status.sh --summary}}",
      "bar": [
        {
          "type": "button",
          "name": "battery-btn",
          "label": "{{watch:/home/oni/.config/ironbar/battery-status.sh --icon}}",
          "on_click": "popup:toggle"
        }
      ],
      "popup": [
        {
          "type": "box",
          "orientation": "vertical",
          "widgets": [
            { "type": "label", "class": "popup-title", "label": "Battery" },
            { "type": "label", "class": "stats", "justify": "left", "label": "{{watch:python3 /home/oni/.config/ironbar/panel-status.py battery}}" }
          ]
        }
      ]
    },
    {
      "type": "clock",
      "name": "clock",
      "class": "item-clock",
      "format": "%H:%M",
      "format_popup": "%A, %d %B %Y"
    }
  ],
  "end": []
}
